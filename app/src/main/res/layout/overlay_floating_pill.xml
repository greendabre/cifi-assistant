<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/pill_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <!-- Drag Handle -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="16dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Drag Overlay"
        android:src="@drawable/ic_drag" />

    <!-- Scan Button with Badge -->
    <TextView
        android:id="@+id/btnOverlayScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_scan_bg"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="⚡ Scan [0/9]"
        android:textColor="@color/cyan_400"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="6dp"
        android:layout_height="0dp" />

    <!-- Dossier Button -->
    <TextView
        android:id="@+id/btnOverlayDossier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_dossier_bg"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="📋 Dossier"
        android:textColor="@color/purple_400"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="6dp"
        android:layout_height="0dp" />

    <!-- Close / Dismiss button -->
    <TextView
        android:id="@+id/btnOverlayClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/button_close_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
